APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== Tài khoản quản trị đầu tiên (php artisan db:seed) =====
# Để trống ADMIN_PASSWORD thì dùng "password" (khách tự đổi ở màn Cài đặt)
ADMIN_NAME="Khoa Anh Music"
ADMIN_EMAIL=admin@khoaanhmusic.com
ADMIN_PASSWORD=

# Tài khoản kỹ thuật của bên triển khai: toàn quyền, không hiện ở màn Nhân sự (khách không xoá / đổi mật khẩu được).
# Để trống SYSTEM_ADMIN_PASSWORD thì dùng "password@123". Để trống SYSTEM_ADMIN_EMAIL thì không tạo.
# Quên mật khẩu tài khoản nào thì trên server chạy: php artisan sis:reset-password <email>
SYSTEM_ADMIN_EMAIL=system_admin@mail.com
SYSTEM_ADMIN_PASSWORD=

# ===== Sao lưu dữ liệu (xem config/backup.php) =====
# Thư mục lưu bản backup trên máy host (mặc định storage/app/backups)
# BACKUP_PATH=
BACKUP_KEEP_LOCAL=14
BACKUP_SCHEDULE_TIME=02:00
# Đẩy lên Google Drive bằng rclone. Ví dụ remote tên "gdrive", thư mục SIS-Backups
BACKUP_RCLONE_BINARY=rclone
BACKUP_RCLONE_REMOTE=
# BACKUP_RCLONE_CONFIG=C:\rclone\rclone.conf
BACKUP_RCLONE_KEEP_DAYS=30
